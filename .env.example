# Copy to .env and fill in. Never commit .env.

# Step 1 - free key: https://api.data.gov/signup/
SCORECARD_API_KEY=

# Step 2 - search/extract, free tier at https://tavily.com
TAVILY_API_KEY=

# Step 2 - LLM: "openai" (default) or "ollama"
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only if LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral-small3.1:24b
# OLLAMA_NUM_CTX=24576
# MAX_PAGE_TEXT_CHARS=32000

# Optional: User-Agent sent to Wikipedia (include a contact URL/email per their policy)
# WIKIPEDIA_USER_AGENT=MyApp/1.0 (https://example.com/contact)
